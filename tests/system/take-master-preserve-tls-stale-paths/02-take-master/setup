#!/bin/bash
#
# Topology: 10111 -> 10112 -> 10113. Give every sandbox mysqld its own
# certificate and switch 10113 to TLS replication with
# SOURCE_SSL_VERIFY_SERVER_CERT=1.
#
# Intermediate master 10112 replicates from 10111 with SOURCE_SSL=0, but its
# channel still holds certificate paths that no longer exist, as left behind
# when TLS was turned off on a channel. take-master makes 10112 replicate from
# 10113 and sets up TLS from 10112's own server TLS configuration.
#
# 10112's ssl_cert and ssl_key are then cleared, so orchestrator has no
# certificate or key to set. MySQL keeps channel options that a CHANGE
# REPLICATION SOURCE TO does not mention, so the stale paths must be cleared
# explicitly, or 10112 cannot connect to 10113. The variables are cleared
# without ALTER INSTANCE RELOAD TLS, so 10112 keeps serving TLS with the
# certificate already loaded.
#
set -euo pipefail
test-tls-setup-certs
test-tls-enable-replica 10113 1
mysql -uci -pci -h127.0.0.1 --port=10112 -e "
  STOP REPLICA;
  CHANGE REPLICATION SOURCE TO
    SOURCE_SSL = 0,
    SOURCE_SSL_CA = '/nonexistent/stale-ca.pem',
    SOURCE_SSL_CERT = '/nonexistent/stale-cert.pem',
    SOURCE_SSL_KEY = '/nonexistent/stale-key.pem';
  START REPLICA;
  SET GLOBAL ssl_cert = '';
  SET GLOBAL ssl_key = '';
"
for _ in $(seq 1 30); do
  io=$(mysql -uci -pci -h127.0.0.1 --port=10112 -e "SHOW REPLICA STATUS\G" | sed -n 's/^ *Replica_IO_Running: *//p')
  [ "$io" = "Yes" ] && break
  sleep 1
done
if [ "$io" != "Yes" ]; then
  echo "ERROR: replica 10112 IO thread not running with SOURCE_SSL=0 and stale certificate paths" >&2
  exit 1
fi
orchestrator-client -c discover -i 127.0.0.1:10112 >/dev/null
