#!/bin/bash
#
# Usage: test-with-tls-credentials-query <command> [args...]
#
# Runs <command> with ReplicationCredentialsQuery set to a query that returns,
# besides the replication user and password, the server TLS configuration
# (@@ssl_ca, @@ssl_cert, @@ssl_key) of the host it runs on. Orchestrator runs
# the query on a replica, so it returns that replica's own, host-specific
# certificate paths.
#
# reload-configuration keeps settings that the reloaded file does not mention,
# so the query is reset explicitly when <command> exits; otherwise it would
# stay set for the tests that follow.
#
set -e

config_dir=$(mktemp -d /tmp/orch_ci_creds_query_XXXXXX)
chmod 755 "$config_dir"
cat > "$config_dir/set.json" <<'JSON'
{
  "ReplicationCredentialsQuery": "SELECT User_name AS user, User_password AS password, @@global.ssl_ca AS sslCaCert, @@global.ssl_cert AS sslCert, @@global.ssl_key AS sslKey FROM mysql.slave_master_info LIMIT 1"
}
JSON
cat > "$config_dir/reset.json" <<'JSON'
{
  "ReplicationCredentialsQuery": ""
}
JSON
chmod 644 "$config_dir"/*.json

trap 'orchestrator-client -c api -path "reload-configuration?config=${config_dir}/reset.json" >/dev/null; rm -rf "$config_dir"' EXIT
orchestrator-client -c api -path "reload-configuration?config=${config_dir}/set.json" >/dev/null
"$@"
