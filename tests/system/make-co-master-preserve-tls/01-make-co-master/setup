#!/bin/bash
#
# Give every sandbox mysqld its own certificate and switch replica 10113 to TLS
# replication with SOURCE_SSL_VERIFY_SERVER_CERT=1. Master 10111 has no
# replication channel, so it has no replication TLS settings that orchestrator
# could preserve when it makes 10111 replicate from 10113.
#
set -euo pipefail
test-tls-setup-certs
test-tls-enable-replica 10113 1
